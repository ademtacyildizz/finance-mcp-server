# ---------------------------------------------------------------------------
# finance-mcp-server configuration
#
# Copy to .env and fill in only the services you actually use.
# An integration is registered ONLY if its required variables are present,
# so you can start with one service and add the rest later.
#
# .env is gitignored. Never commit real tokens.
# ---------------------------------------------------------------------------

# --- Global -----------------------------------------------------------------
# HTTP timeout for all REST calls (ms)
HTTP_TIMEOUT_MS=30000
# Hard cap on a single tool result, in characters. Protects the model's context.
MAX_RESULT_CHARS=60000


# --- Instana ----------------------------------------------------------------
# Your tenant unit URL, e.g. https://acme-prod.instana.io
# Token: Instana UI > Settings > API Tokens
INSTANA_BASE_URL=
INSTANA_API_TOKEN=


# --- GitLab -----------------------------------------------------------------
# gitlab.com or your self-hosted instance, e.g. https://gitlab.acme.com
# Token: User Settings > Access Tokens (scopes: read_api, or api for write ops)
GITLAB_BASE_URL=https://gitlab.com
GITLAB_TOKEN=
# "pat" (default, sends PRIVATE-TOKEN) or "oauth" (sends Authorization: Bearer)
GITLAB_TOKEN_TYPE=pat
# Allow pipeline retry/cancel/play. Read-only when false.
GITLAB_ALLOW_WRITE=false


# --- Grafana ----------------------------------------------------------------
# e.g. https://grafana.acme.com
# Token: Administration > Service accounts > Add service account token
GRAFANA_BASE_URL=
GRAFANA_TOKEN=
# Optional: target a specific org on a multi-org instance
GRAFANA_ORG_ID=


# --- Jira -------------------------------------------------------------------
# Cloud:  https://yourcompany.atlassian.net  + JIRA_EMAIL + API token
#         (https://id.atlassian.com/manage-profile/security/api-tokens)
# Server/Data Center: https://jira.acme.com   + JIRA_API_TOKEN only (a PAT)
JIRA_BASE_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=
# Auto-detected: 3 for *.atlassian.net (Cloud), 2 otherwise. Override if needed.
JIRA_API_VERSION=
# Allow creating issues, commenting and transitioning. Read-only when false.
JIRA_ALLOW_WRITE=false


# --- Kubernetes -------------------------------------------------------------
# Talks to your cluster by shelling out to kubectl, so it reuses the exact
# kubeconfig, context and auth plugins your terminal already uses.
K8S_ENABLED=true
KUBECTL_PATH=kubectl
# Leave empty to use ~/.kube/config
KUBECONFIG=
# Leave empty to use the current-context
K8S_CONTEXT=
# Default namespace when a tool call omits one
K8S_DEFAULT_NAMESPACE=default
# Comma-separated allowlist. Empty = all namespaces permitted.
K8S_NAMESPACES=
# Allow scale / rollout restart / delete pod. Read-only when false.
K8S_ALLOW_WRITE=false
# Timeout for a single kubectl invocation (ms)
K8S_TIMEOUT_MS=30000
